{
  "name": "ctos",
  "version": "1.0.0",
  "description": "ctOS Tactical Voice Bridge & Audio Matrix",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "socket.io-client": "^4.8.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ctos.client",
    "productName": "ctOS",
    "publish": [
      {
        "provider": "github",
        "owner": "slaymuffin",
        "repo": "ctos-client"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "ctOS.ico",
      "sign": "./sign.js",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
